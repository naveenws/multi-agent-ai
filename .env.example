# Database
# Use postgres in production/docker, but sqlite is easier for local non-docker testing if preferred.
# Postgres example (matches docker-compose):
DATABASE_URL=postgresql+asyncpg://admin:adminpassword@localhost:5432/multiagentdb
# SQLite fallback for quick local testing:
# DATABASE_URL=sqlite+aiosqlite:///./multiagent.db

# API Keys (Do not commit real keys!)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
